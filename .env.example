# --- Database (Postgres 16) ---
DATABASE_URL=postgres://wb:wb@localhost:5432/workingbetter
# Ruolo applicativo soggetto a RLS (impostato con SET LOCAL ROLE in ogni transazione tenant). Vuoto = nessun SET ROLE.
DB_APP_ROLE=wb_app

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth (ADR-0007) ---
# dev  = login di sviluppo attivo (senza password) oltre a password e SSO
# prod = solo password e SSO per tenant
AUTH_MODE=dev
AUTH_DEV_SECRET=change-me-in-dev-only-32-chars-minimum
# chiave HS256 delle sessioni emesse dall'API (obbligatoria in prod; in dev ricade su AUTH_DEV_SECRET)
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_HOURS=12
# IdP di piattaforma opzionale per client macchina (token RS256 verificati via JWKS); l'SSO per tenant si configura dall'app
AUTH_ISSUER=
AUTH_AUDIENCE=workingbetter-api
# URL pubblici: link nelle email (inviti, reset) e redirect URI del flusso OIDC
APP_BASE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# --- Worker (apps/workers) ---
# log = le email vengono scritte nel log; smtp = invio reale via SMTP_URL
EMAIL_TRANSPORT=log
SMTP_URL=
EMAIL_FROM=WorkingBetter <no-reply@workingbetter.local>
APP_BASE_URL=http://localhost:3000
REMINDERS_CRON=0 7 * * *
MART_REFRESH_CRON=30 2 * * *
EMAIL_DISPATCH_EVERY_MS=30000
# worker: ammette webhook verso indirizzi privati/locali (solo sviluppo; in produzione lasciare false)
ALLOW_PRIVATE_URLS=true

# Cifratura note private 1:1 (32 byte hex). Genera con: openssl rand -hex 32
# chiave master (64 hex): cifra note private, segreti SSO/MFA e token dei connettori; identica per API e worker
NOTES_MASTER_KEY=

# --- API ---
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000
# true dietro reverse proxy: l'IP del client viene letto da X-Forwarded-For (rate limiting, audit)
API_TRUST_PROXY=false

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# Calendario (ADR-0010): mittente logico (ORGANIZER) degli inviti iCalendar; deve coincidere con l'indirizzo in EMAIL_FROM
CALENDAR_ORGANIZER_EMAIL=no-reply@workingbetter.local

# URL del manuale operativo pubblicato (docs/manuale reso come sito statico); se vuoto la Guida in app mostra solo il riferimento al capitolo
NEXT_PUBLIC_MANUAL_URL=

# --- Console di piattaforma (ADR-0013): app separata su porta 8443, riservata agli operatori ---
CONSOLE_PORT=8443
# TLS nativo della console (altrimenti HTTP dietro reverse proxy)
CONSOLE_TLS_CERT_FILE=
CONSOLE_TLS_KEY_FILE=
# URL pubblico della console (usato per il cookie Secure e per il monitoraggio del certificato)
CONSOLE_PUBLIC_URL=http://localhost:8443
# primo operatore creato all'avvio dell'API se non ne esiste nessuno (in alternativa: pnpm --filter @wb/db platform-admin)
PLATFORM_BOOTSTRAP_EMAIL=
PLATFORM_BOOTSTRAP_PASSWORD=
# certificati locali (PEM, separati da virgola) di cui la console mostra la scadenza
TLS_CERT_FILES=
