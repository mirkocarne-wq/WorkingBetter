# --- Database (Postgres 16) ---
DATABASE_URL=postgres://wb:wb@localhost:5432/workingbetter
# Ruolo applicativo soggetto a RLS (impostato con SET LOCAL ROLE in ogni transazione tenant). Vuoto = nessun SET ROLE.
DB_APP_ROLE=wb_app

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# dev  = JWT HS256 firmati con AUTH_DEV_SECRET (solo sviluppo/test)
# oidc = JWT RS256 verificati via JWKS dell'issuer (Keycloak)
AUTH_MODE=dev
AUTH_DEV_SECRET=change-me-in-dev-only-32-chars-minimum
AUTH_ISSUER=http://localhost:8080/realms/workingbetter
AUTH_AUDIENCE=workingbetter-api

# --- API ---
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
