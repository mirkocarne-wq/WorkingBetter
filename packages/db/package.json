{
  "name": "@wb/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && rm -rf dist/drizzle && cp -r drizzle dist/drizzle",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "bootstrap": "tsx src/scripts/bootstrap.ts"
  },
  "dependencies": {
    "@wb/shared": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "postgres": "^3.4.4",
    "@electric-sql/pglite": "^0.3.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "eslint": "^9.12.0",
    "typescript-eslint": "^8.8.0",
    "@types/node": "^22.7.0"
  }
}
