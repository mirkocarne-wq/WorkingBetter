{
  "name": "@wb/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Client TypeScript generato dal contratto OpenAPI dell'API WorkingBetter (ADR-0005, ADR-0009)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "files": ["dist", "openapi.json"],
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.ts --alphabetize --empty-objects-unknown",
    "check": "node scripts/check.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "eslint": "^9.12.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  }
}
