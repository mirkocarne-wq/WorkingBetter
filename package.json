{
  "name": "workingbetter",
  "private": true,
  "version": "0.1.0",
  "description": "WorkingBetter \u2014 performance management & employee experience platform",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css}\"",
    "db:generate": "pnpm --filter @wb/db generate",
    "db:migrate": "pnpm --filter @wb/db migrate",
    "db:seed": "pnpm --filter @wb/db seed",
    "contract:check": "pnpm --filter @wb/api openapi:emit && git diff --exit-code -- packages/api-client/openapi.json && pnpm --filter @wb/api-client check",
    "contract:update": "pnpm --filter @wb/api openapi:emit && pnpm --filter @wb/api-client generate"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core",
      "@electric-sql/pglite"
    ]
  }
}
