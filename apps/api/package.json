{
  "name": "@wb/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node scripts/dev.mjs",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src test",
    "openapi:emit": "tsc -p tsconfig.json && node dist/scripts/openapi.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@wb/connectors": "workspace:*",
    "@wb/db": "workspace:*",
    "@wb/shared": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.0.0",
    "jose": "^5.9.0",
    "nestjs-zod": "^4.0.0",
    "otpauth": "^9.5.2",
    "pdfkit": "0.15.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.7.0",
    "@types/node": "^22.7.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^2.1.0"
  }
}
